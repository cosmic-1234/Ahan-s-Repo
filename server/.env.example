# ═══════════════════════════════════════════════════════════
# Partnership Fitment Agent — Environment Variables
# ═══════════════════════════════════════════════════════════

# ── PRIMARY: OpenRouter (RECOMMENDED — Free, No Daily Limits) ──
# Get a FREE key at: https://openrouter.ai/  (no credit card needed)
# Free models include: meta-llama/llama-3.3-70b-instruct:free
# No daily token cap — only per-minute rate limits (recovers in 60s)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── FALLBACK: Groq (Free, 100K tokens/day) ────────────────────
# Get a FREE key at: https://console.groq.com
# Pro tip: Add up to 3 keys for rotation (GROQ_API_KEY_2, GROQ_API_KEY_3)
# Each key adds 100K tokens/day — 3 keys = 300K tokens/day
GROQ_API_KEY=gsk_your-key-here
# GROQ_API_KEY_2=gsk_your-second-key-here
# GROQ_API_KEY_3=gsk_your-third-key-here

# ── Optional: MongoDB (persistent storage across Render restarts) ──
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/partnership_fitment

# ── Server Port ────────────────────────────────────────────────
PORT=3001
